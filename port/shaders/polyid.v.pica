; Edge marking's polygon-ID pass: positions and texture coordinates as poly.v.pica, the colour is
; (polygon ID, depth, 0, 1) with depth = A + B * z/w spread over the frame's range (larger is
; nearer; A = B = 0 for translucent polygons, which only clear the edge flag).
.fvec xform      ; (x scale, y scale (negative), x offset, y offset: clip units per w, the seam-fill pass)
.fvec tcscale    ; (1 / texture width, 1 / texture height, 0, 0)
.fvec wbuf       ; (1: W-buffering, 1 / the frame's largest w, 0, 0): depth from w, not z (SwapBuffers bit 1)
.fvec stereo     ; (eye shift, convergence z/w, depth range, 0): x/w += shift * clamp(z/w - convergence, 0, range) (stereoscopic 3D)
.fvec idp        ; (ID * 4 / 255, A, B, 0)

.constf consts(0.0, 0.5, 0.0, 1.0)

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inclr v1
.alias intc  v2

.proc main
	mul r0.x, xform.x, inpos.x
	mul r0.y, xform.y, inpos.y
	mul r6.xy, xform.zwzw, inpos.wwww
	add r0.xy, r0.xy, r6.xy
	mul r1.z, stereo.y, inpos.w
	add r1.y, inpos.z, -r1.z
	mul r1.w, stereo.z, inpos.w
	max r1.y, consts.z, r1.y
	min r1.y, r1.w, r1.y
	mul r1.y, stereo.x, r1.y
	add r0.x, r0.x, r1.y
	add r1.x, inpos.z, -inpos.w
	mul r1.x, consts.y, r1.x
	; W-buffering: depth 1 - w / wmax (nearer: larger), as z = w * w / wmax - w; blended in by wbuf.x
	mul r7.x, inpos.w, inpos.w
	mul r7.x, wbuf.y, r7.x
	add r7.x, -inpos.w, r7.x
	add r7.x, -r1.x, r7.x
	mul r7.x, wbuf.x, r7.x
	add r0.z, r1.x, r7.x
	mov r0.w, inpos.w
	mov outpos, r0
	rcp r3.x, inpos.w
	mul r3.x, inpos.z, r3.x
	mul r3.x, idp.z, r3.x
	add r3.y, idp.y, r3.x
	mov r4.x, idp.x
	mov r4.y, r3.y
	mov r4.zw, consts.zw
	mov outclr, r4
	mul r2.xy, tcscale.xy, intc.xy
	mov r2.zw, consts.zw
	mov outtc0, r2
	end
.end
