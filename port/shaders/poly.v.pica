; The 3D renderer's vertex shader. Vertices come straight from the geometry engine (gx3d.c
; G3Vtx, in GPU-visible memory): clip-space position as the DS computed it, colour as 4 bytes,
; texture coordinates in texels. Here: y flipped (render-to-texture), x/y scaled when the view is
; widened, the DS's z/w in -1..1 to the PICA's -w..0, colour to 0..1, texels to 0..1.
.fvec xform      ; (x scale, y scale (negative), 0, 0)
.fvec tcscale    ; (1 / texture width, 1 / texture height, 0, 0)
.fvec stereo     ; (eye shift, convergence z/w, depth range, 0): x/w += shift * clamp(z/w - convergence, 0, range) (stereoscopic 3D)

.constf consts(0.00392156862745, 0.5, 0.0, 1.0)

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inclr v1
.alias intc  v2

.proc main
	mul r0.x, xform.x, inpos.x
	mul r0.y, xform.y, inpos.y
	mul r1.z, stereo.y, inpos.w
	add r1.y, inpos.z, -r1.z
	mul r1.w, stereo.z, inpos.w
	max r1.y, consts.z, r1.y
	min r1.y, r1.w, r1.y
	mul r1.y, stereo.x, r1.y
	add r0.x, r0.x, r1.y
	add r1.x, inpos.z, -inpos.w
	mul r0.z, consts.y, r1.x
	mov r0.w, inpos.w
	mov outpos, r0
	mul outclr, consts.xxxx, inclr
	mul r2.xy, tcscale.xy, intc.xy
	mov r2.zw, consts.zw
	mov outtc0, r2
	end
.end
